{
  "name": "vinted-pipeline",
  "version": "1.0.0",
  "description": "Local app that checks whether a photo comes from a fast-fashion shop such as Shein or Temu",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "ingest": "tsx src/ingest.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@huggingface/transformers": "^4.3.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "sharp-phash": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
