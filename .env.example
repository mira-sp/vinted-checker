# Copy this file to .env and fill in what you need. All values are optional.
# Restart the app after changing anything here.

# Port the app listens on (always 127.0.0.1).
PORT=3000

# Google Cloud Vision API key. Turns on the online reverse image search.
# Leave empty to check only against your saved reference photos.
GOOGLE_VISION_API_KEY=

# Image model for the visual check: clip (general) or fashion-siglip (trained on fashion).
# After switching, run: npm run reembed -- --model <name>
EMBEDDING_MODEL=clip

# Minimum visual similarity (0 to 1) for a match. Each model needs its own value;
# find it with: npm run eval
CLIP_THRESHOLD=0.88
