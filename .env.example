# Copy this file to .env and fill in what you need. All values are optional.

# Port the app listens on (always 127.0.0.1).
PORT=3000

# Google Cloud Vision API key. Turns on the online reverse image search.
# Leave empty to check only against your saved reference images.
GOOGLE_VISION_API_KEY=

# Minimum CLIP similarity (0 to 1) for a visual match against saved references.
CLIP_THRESHOLD=0.88
